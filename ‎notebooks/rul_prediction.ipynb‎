        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# DATA LOADING\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def load_data(dataset):\n",
        "    cols     = ['id','cycle','op1','op2','op3'] + [f's{i}' for i in range(1,22)]\n",
        "    train_df = pd.read_csv(f\"train_{dataset}.txt\", sep=r\"\\s+\", header=None)\n",
        "    train_df.columns = cols\n",
        "    test_df  = pd.read_csv(f\"test_{dataset}.txt\",  sep=r\"\\s+\", header=None)\n",
        "    test_df.columns  = cols\n",
        "    y_test   = pd.read_csv(f\"RUL_{dataset}.txt\", header=None).values.flatten()\n",
        "    return train_df, test_df, y_test\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# MLP REGRESSION NORMALIZATION — key fix for FD002/FD004\n",
        "# Trains MLP(op1,op2,op3) → sensor for each sensor\n",
        "# Uses residuals as features — removes condition effects completely\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def mlp_condition_normalize(train_df, test_df, sensor_cols):\n",
        "    train_df = train_df.copy()\n",
        "    test_df  = test_df.copy()\n",
        "    op_cols  = ['op1','op2','op3']\n",
        "    for col in sensor_cols:\n",
        "        mlp = MLPRegressor(hidden_layer_sizes=(16,), max_iter=500,\n",
        "                           random_state=SEED, alpha=0.01)\n",
        "        mlp.fit(train_df[op_cols], train_df[col])\n",
        "        train_df[col] = train_df[col] - mlp.predict(train_df[op_cols])\n",
        "        test_df[col]  = test_df[col]  - mlp.predict(test_df[op_cols])\n",
        "    return train_df, test_df\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# PREPROCESSING\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def preprocess(train_df, test_df, dataset):\n",
        "    cfg       = DATASET_CONFIG[dataset]\n",
        "    threshold = cfg['rul_threshold']\n",
        "    seq_len   = cfg['seq_len']\n",
        "\n",
        "    max_cycle         = train_df.groupby('id')['cycle'].max().reset_index()\n",
        "    max_cycle.columns = ['id','max_cycle']\n",
        "    train_df          = train_df.merge(max_cycle, on='id')\n",
        "    train_df['RUL']   = (train_df['max_cycle'] - train_df['cycle']).clip(upper=threshold)\n",
        "    train_df.drop(columns=['max_cycle'], inplace=True)\n",
        "\n",
        "    # ALL features kept — no dropping\n",
        "    feature_cols = [c for c in train_df.columns if c not in ['id','RUL']]\n",
        "    sensor_cols  = [c for c in feature_cols if c.startswith('s')]\n",
        "\n",
        "    if cfg['multi_condition']:\n",
        "        train_df, test_df = mlp_condition_normalize(train_df, test_df, sensor_cols)\n",
        "\n",
        "    scaler = MinMaxScaler(feature_range=(0,1))\n",
        "    train_df[feature_cols] = scaler.fit_transform(train_df[feature_cols])\n",
        "    test_df[feature_cols]  = scaler.transform(test_df[feature_cols])\n",
        "\n",
        "    return train_df, test_df, feature_cols, seq_len\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# SEQUENCES\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def create_sequences(df, feature_cols, seq_len):\n",
        "    X_seqs, y_seqs = [], []\n",
        "    for eid in df['id'].unique():\n",
        "        data = df[df['id'] == eid][feature_cols + ['RUL']].values\n",
        "        for i in range(len(data) - seq_len):\n",
        "            X_seqs.append(data[i:i+seq_len, :-1])\n",
        "            y_seqs.append(data[i+seq_len, -1])\n",
        "    return np.array(X_seqs, dtype=np.float32), np.array(y_seqs, dtype=np.float32)\n",
        "\n",
        "def create_test_sequences(test_df, feature_cols, seq_len):\n",
        "    X_test = []\n",
        "    for eid in test_df['id'].unique():\n",
        "        ed = test_df[test_df['id'] == eid][feature_cols].values\n",
        "        if len(ed) < seq_len:\n",
        "            pad = np.zeros((seq_len - len(ed), ed.shape[1]))\n",
        "            ed  = np.vstack([pad, ed])\n",
        "        else:\n",
        "            ed = ed[-seq_len:]\n",
        "        X_test.append(ed)\n",
        "    return np.array(X_test, dtype=np.float32)\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# METRICS\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def nasa_score(y_true, y_pred):\n",
        "    diff = y_pred - y_true\n",
        "    return float(np.sum(np.where(diff < 0, np.exp(-diff/13)-1, np.exp(diff/10)-1)))\n",
        "\n",
        "def report_metrics(name, true, pred):\n",
        "    mse  = mean_squared_error(true, pred)\n",
        "    rmse = np.sqrt(mse)\n",
        "    mae  = mean_absolute_error(true, pred)\n",
        "    nasa = nasa_score(true, pred)\n",
        "    print(f\"{name:40s} MSE={mse:.3f} RMSE={rmse:.3f} MAE={mae:.3f} NASA={nasa:.1f}\")\n",
        "    return rmse, mae, mse, nasa\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# CALLBACKS\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def get_callbacks():\n",
        "    return [\n",
        "        EarlyStopping(monitor='val_loss', patience=20,\n",
        "                      restore_best_weights=True, verbose=0),\n",
        "        ReduceLROnPlateau(monitor='val_loss', factor=0.5,\n",
        "                          patience=8, min_lr=1e-7, verbose=1)\n",
        "    ]\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# MODELS — standalone, no hybrids\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def build_bilstm(seq_len, n_features):\n",
        "    inputs  = Input(shape=(seq_len, n_features))\n",
        "    x       = Bidirectional(LSTM(64, return_sequences=True,\n",
        "                                 recurrent_dropout=0.05))(inputs)\n",
        "    x       = Dropout(0.1)(x)\n",
        "    attn    = MultiHeadAttention(num_heads=4, key_dim=32, dropout=0.05)(x, x)\n",
        "    x       = LayerNormalization()(Add()([x, attn]))\n",
        "    ffn     = Dense(128, activation='relu')(x)\n",
        "    ffn     = Dense(x.shape[-1])(ffn)\n",
        "    x       = LayerNormalization()(Add()([x, ffn]))\n",
        "    x       = GlobalAveragePooling1D()(x)\n",
        "    x       = Dense(64, activation='relu')(x)\n",
        "    x       = Dropout(0.1)(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model   = Model(inputs, outputs)\n",
        "    model.compile(optimizer=Adam(8e-5), loss=Huber(), metrics=['mae'])\n",
        "    return model\n",
        "\n",
        "def tcn_block(x, filters, kernel_size, dilation_rate, dropout=0.1):\n",
        "    residual = x\n",
        "    x = Conv1D(filters, kernel_size, padding='causal',\n",
        "               dilation_rate=dilation_rate, activation='relu')(x)\n",
        "    x = BatchNormalization()(x)\n",
        "    x = Dropout(dropout)(x)\n",
        "    x = Conv1D(filters, kernel_size, padding='causal',\n",
        "               dilation_rate=dilation_rate, activation='relu')(x)\n",
        "    x = BatchNormalization()(x)\n",
        "    if residual.shape[-1] != filters:\n",
        "        residual = Conv1D(filters, 1, padding='same')(residual)\n",
        "    return Add()([x, residual])\n",
        "\n",
        "def build_tcn(seq_len, n_features):\n",
        "    inputs = Input(shape=(seq_len, n_features))\n",
        "    x      = inputs\n",
        "    for d in [1, 2, 4, 8]:\n",
        "        x = tcn_block(x, 64, 3, d, 0.1)\n",
        "    attn    = MultiHeadAttention(num_heads=4, key_dim=16, dropout=0.05)(x, x)\n",
        "    x       = LayerNormalization()(Add()([x, attn]))\n",
        "    x       = GlobalAveragePooling1D()(x)\n",
        "    x       = Dense(64, activation='relu')(x)\n",
        "    x       = Dropout(0.1)(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model   = Model(inputs, outputs)\n",
        "    model.compile(optimizer=Adam(5e-4), loss=Huber(), metrics=['mae'])\n",
        "    return model\n",
        "\n",
        "def transformer_block(x, d_model, num_heads, ff_dim, dropout=0.1):\n",
        "    attn = MultiHeadAttention(num_heads=num_heads,\n",
        "                              key_dim=d_model//num_heads,\n",
        "                              dropout=dropout)(x, x)\n",
        "    x    = LayerNormalization()(Add()([x, attn]))\n",
        "    ffn  = Dense(ff_dim, activation='relu')(x)\n",
        "    ffn  = Dense(d_model)(ffn)\n",
        "    return LayerNormalization()(Add()([x, ffn]))\n",
        "\n",
        "def build_transformer(seq_len, n_features):\n",
        "    inputs    = Input(shape=(seq_len, n_features))\n",
        "    x         = Dense(64)(inputs)\n",
        "    positions = tf.range(start=0, limit=seq_len, delta=1)\n",
        "    pos_emb   = tf.keras.layers.Embedding(seq_len, 64)(positions)\n",
        "    x         = x + pos_emb\n",
        "    for _ in range(2):\n",
        "        x = transformer_block(x, 64, 4, 128, 0.1)\n",
        "    x       = GlobalAveragePooling1D()(x)\n",
        "    x       = Dense(64, activation='relu')(x)\n",
        "    x       = Dropout(0.1)(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model   = Model(inputs, outputs)\n",
        "    model.compile(optimizer=Adam(5e-4), loss=Huber(), metrics=['mae'])\n",
        "    return model\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# PLOTS\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "def plot_loss(h, name, ds):\n",
        "    plt.figure(figsize=(10,5))\n",
        "    plt.plot(h.history['loss'], label='Train')\n",
        "    plt.plot(h.history['val_loss'], label='Val')\n",
        "    plt.title(f'{name} — Loss ({ds})')\n",
        "    plt.xlabel('Epoch'); plt.ylabel('Loss')\n",
        "    plt.legend(); plt.grid(); plt.show()\n",
        "\n",
        "def plot_predictions(y_test, preds_dict, ds):\n",
        "    plt.figure(figsize=(14,5))\n",
        "    plt.plot(y_test, label='Actual', linewidth=2, color='black')\n",
        "    for (n,p),c in zip(preds_dict.items(),['blue','green','red','orange','purple']):\n",
        "        plt.plot(p, label=n, linewidth=1.5, alpha=0.8, color=c)\n",
        "    plt.title(f'Predictions — {ds}'); plt.legend(); plt.grid(); plt.show()\n",
        "\n",
        "def plot_residuals(y_test, pred, name, ds):\n",
        "    res = y_test - pred\n",
        "    plt.figure(figsize=(10,4))\n",
        "    plt.scatter(range(len(res)), res, alpha=0.6)\n",
        "    plt.axhline(0, linestyle='--', color='black')\n",
        "    plt.title(f'Residuals — {name} ({ds})')\n",
        "    plt.grid(); plt.show()\n",
        "\n",
        "def plot_bar(results, ds):\n",
        "    names = list(results.keys())\n",
        "    vals  = [results[m]['rmse'] for m in names]\n",
        "    plt.figure(figsize=(10,5))\n",
        "    bars = plt.bar(names, vals,\n",
        "                   color=['steelblue','darkorange','green','red','purple'])\n",
        "    plt.bar_label(bars, fmt='%.2f', padding=3)\n",
        "    plt.title(f'Test RMSE — {ds}')\n",
        "    plt.ylabel('RMSE'); plt.grid(axis='y'); plt.show()\n",
        "\n",
        "def plot_rul_dist(train_df, ds):\n",
        "    plt.figure(figsize=(10,5))\n",
        "    plt.hist(train_df['RUL'], bins=40, color='steelblue', edgecolor='white')\n",
        "    plt.title(f'RUL Distribution — {ds}')\n",
        "    plt.xlabel('RUL'); plt.ylabel('Frequency')\n",
        "    plt.grid(); plt.show()\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# MAIN LOOP\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "DATASETS    = ['FD001','FD002','FD003','FD004']\n",
        "all_results = {}\n",
        "\n",
        "for dataset in DATASETS:\n",
        "    print(f\"\\n{'█'*60}\\n  DATASET: {dataset}\\n{'█'*60}\")\n",
        "\n",
        "    train_raw, test_raw, y_test = load_data(dataset)\n",
        "    train_df, test_df, feature_cols, seq_len = preprocess(\n",
        "        train_raw.copy(), test_raw.copy(), dataset)\n",
        "\n",
        "    plot_rul_dist(train_df, dataset)\n",
        "\n",
        "    eids             = train_df['id'].unique()\n",
        "    tr_e, val_e      = train_test_split(eids, test_size=0.2, random_state=SEED)\n",
        "    X_train, y_train = create_sequences(\n",
        "        train_df[train_df['id'].isin(tr_e)], feature_cols, seq_len)\n",
        "    X_val,   y_val   = create_sequences(\n",
        "        train_df[train_df['id'].isin(val_e)], feature_cols, seq_len)\n",
        "    X_test_seq       = create_test_sequences(test_df, feature_cols, seq_len)\n",
        "    nf               = X_train.shape[2]\n",
        "    print(f\"  Train:{X_train.shape} Val:{X_val.shape} Test:{X_test_seq.shape} nf={nf}\")\n",
        "\n",
        "    val_preds  = {}\n",
        "    test_preds = {}\n",
        "    results    = {}\n",
        "\n",
        "    # ── BiLSTM ────────────────────────────────────────────────────────────────\n",
        "    print(f\"\\n  ── BiLSTM + MHA ──\")\n",
        "    bilstm   = build_bilstm(seq_len, nf)\n",
        "    h_bilstm = bilstm.fit(X_train, y_train,\n",
        "                           validation_data=(X_val, y_val),\n",
        "                           epochs=100, batch_size=64,\n",
        "                           callbacks=get_callbacks(), verbose=0)\n",
        "    vp = bilstm.predict(X_val,      verbose=0).flatten()\n",
        "    tp = bilstm.predict(X_test_seq, verbose=0).flatten()\n",
        "    val_preds['BiLSTM']  = vp\n",
        "    test_preds['BiLSTM'] = tp\n",
        "    print(\"  Validation:\"); report_metrics(\"  BiLSTM\", y_val, vp)\n",
        "    print(\"  Test:\");\n",
        "    r,m,ms,n = report_metrics(\"  BiLSTM\", y_test, tp)\n",
        "    results['BiLSTM'] = {'rmse':r,'mae':m,'mse':ms,'nasa':n}\n",
        "    plot_loss(h_bilstm, 'BiLSTM+MHA', dataset)\n",
        "\n",
        "    # ── TCN ───────────────────────────────────────────────────────────────────\n",
        "    print(f\"\\n  ── TCN + Attention ──\")\n",
        "    tcn   = build_tcn(seq_len, nf)\n",
        "    h_tcn = tcn.fit(X_train, y_train,\n",
        "                    validation_data=(X_val, y_val),\n",
        "                    epochs=100, batch_size=64,\n",
        "                    callbacks=get_callbacks(), verbose=0)\n",
        "    vp = tcn.predict(X_val,      verbose=0).flatten()\n",
        "    tp = tcn.predict(X_test_seq, verbose=0).flatten()\n",
        "    val_preds['TCN']  = vp\n",
        "    test_preds['TCN'] = tp\n",
        "    print(\"  Validation:\"); report_metrics(\"  TCN\", y_val, vp)\n",
        "    print(\"  Test:\");\n",
        "    r,m,ms,n = report_metrics(\"  TCN\", y_test, tp)\n",
        "    results['TCN'] = {'rmse':r,'mae':m,'mse':ms,'nasa':n}\n",
        "    plot_loss(h_tcn, 'TCN+Attn', dataset)\n",
        "\n",
        "    # ── Transformer ───────────────────────────────────────────────────────────\n",
        "    print(f\"\\n  ── Transformer ──\")\n",
        "    transformer   = build_transformer(seq_len, nf)\n",
        "    h_transformer = transformer.fit(X_train, y_train,\n",
        "                                    validation_data=(X_val, y_val),\n",
        "                                    epochs=100, batch_size=64,\n",
        "                                    callbacks=get_callbacks(), verbose=0)\n",
        "    vp = transformer.predict(X_val,      verbose=0).flatten()\n",
        "    tp = transformer.predict(X_test_seq, verbose=0).flatten()\n",
        "    val_preds['Transformer']  = vp\n",
        "    test_preds['Transformer'] = tp\n",
        "    print(\"  Validation:\"); report_metrics(\"  Transformer\", y_val, vp)\n",
        "    print(\"  Test:\");\n",
        "    r,m,ms,n = report_metrics(\"  Transformer\", y_test, tp)\n",
        "    results['Transformer'] = {'rmse':r,'mae':m,'mse':ms,'nasa':n}\n",
        "    plot_loss(h_transformer, 'Transformer', dataset)\n",
        "\n",
        "    # ── Weighted Ensemble ─────────────────────────────────────────────────────\n",
        "    print(f\"\\n  ── Optimized Weighted Ensemble ──\")\n",
        "    names = list(val_preds.keys())\n",
        "    preds = [val_preds[k] for k in names]\n",
        "    res   = minimize(\n",
        "        lambda w: np.sqrt(mean_squared_error(\n",
        "            y_val, sum(w[i]*preds[i] for i in range(len(preds))))),\n",
        "        x0=[1/3]*3, bounds=[(0,1)]*3,\n",
        "        constraints={'type':'eq','fun':lambda w:sum(w)-1}\n",
        "    )\n",
        "    w_opt    = dict(zip(names, res.x))\n",
        "    ens_test = sum(w_opt[k]*test_preds[k] for k in w_opt)\n",
        "    print(f\"  Weights: {' | '.join(f'{k}:{v:.3f}' for k,v in w_opt.items())}\")\n",
        "    print(\"  Test:\");\n",
        "    r,m,ms,n = report_metrics(\"  Weighted Ensemble\", y_test, ens_test)\n",
        "    results['Weighted Ensemble'] = {'rmse':r,'mae':m,'mse':ms,'nasa':n}\n",
        "\n",
        "    # ── Ridge Stacking ────────────────────────────────────────────────────────\n",
        "    print(f\"\\n  ── Ridge Stacking ──\")\n",
        "    ridge = Ridge(alpha=1.0, positive=True)\n",
        "    ridge.fit(np.column_stack([val_preds[k] for k in names]), y_val)\n",
        "    ridge_test = ridge.predict(np.column_stack([test_preds[k] for k in names]))\n",
        "    coefs = dict(zip(names, ridge.coef_))\n",
        "    print(f\"  Coefs: {' | '.join(f'{k}:{v:.3f}' for k,v in coefs.items())}\")\n",
        "    print(\"  Test:\");\n",
        "    r,m,ms,n = report_metrics(\"  Ridge\", y_test, ridge_test)\n",
        "    results['Ridge'] = {'rmse':r,'mae':m,'mse':ms,'nasa':n}\n",
        "\n",
        "    # ── Plots ─────────────────────────────────────────────────────────────────\n",
        "    plot_predictions(y_test,\n",
        "                     {**test_preds,\n",
        "                      'Weighted Ens':ens_test,\n",
        "                      'Ridge':ridge_test},\n",
        "                     dataset)\n",
        "    best = min([k for k in results if 'Ensemble' not in k and k != 'Ridge'],\n",
        "               key=lambda k: results[k]['rmse'])\n",
        "    plot_residuals(y_test, test_preds[best], best, dataset)\n",
        "    plot_residuals(y_test, ens_test, 'Weighted Ensemble', dataset)\n",
        "    plot_bar(results, dataset)\n",
        "\n",
        "    all_results[dataset] = results\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "# FINAL SUMMARY\n",
        "# ══════════════════════════════════════════════════════════════════════════════\n",
        "print(f\"\\n{'═'*80}\\n  FINAL RESULTS — SNIPPET 1 (MLP Normalization)\\n{'═'*80}\")\n",
        "print(f\"{'Model':<22} {'FD001':>10} {'FD002':>10} {'FD003':>10} {'FD004':>10}\")\n",
        "print(f\"{'':─<22} {'RMSE':>10} {'RMSE':>10} {'RMSE':>10} {'RMSE':>10}\")\n",
        "for model in ['BiLSTM','TCN','Transformer','Weighted Ensemble','Ridge']:\n",
        "    row = f\"{model:<22}\"\n",
        "    for ds in DATASETS:\n",
        "        val = all_results[ds].get(model,{}).get('rmse','-')\n",
        "        row += f\" {val:>10.3f}\" if isinstance(val,float) else f\" {val:>10}\"\n",
        "    print(row)\n",
        "\n",
        "print(f\"\\n{'─'*80}\\n  NASA SCORES\\n{'─'*80}\")\n",
        "print(f\"{'Model':<22} {'FD001':>10} {'FD002':>10} {'FD003':>10} {'FD004':>10}\")\n",
        "for model in ['BiLSTM','TCN','Transformer','Weighted Ensemble','Ridge']:\n",
        "    row = f\"{model:<22}\"\n",
        "    for ds in DATASETS:\n",
        "        val = all_results[ds].get(model,{}).get('nasa','-')\n",
        "        row += f\" {val:>10.1f}\" if isinstance(val,float) else f\" {val:>10}\"\n",
        "    print(row)"
      ]
    }
